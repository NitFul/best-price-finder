# Copy this file to ".env" and fill in the values. Never commit .env.
# On Streamlit Community Cloud, put these in the app's "Secrets" box instead.

# Free key from https://serper.dev (no credit card needed).
SERPER_API_KEY=

# true only on your own computer. Leave it out on the public site so
# visitors can't change cashback rates.
ALLOW_RATE_EDITING=false

# Optional: real Amazon prices. Free key at https://serpapi.com
# (free plan: 250 searches/month, so keep the daily cap around 8).
SERPAPI_KEY=
AMAZON_DAILY_LIMIT=8

# Optional: Costco prices via an Apify scraper (~$0.10 per search; Apify's
# free $5/month credit covers ~50). Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
COSTCO_DAILY_LIMIT=2

# Protect your free credits on a public site.
DAILY_SEARCH_LIMIT=60
SESSION_SEARCH_LIMIT=10
